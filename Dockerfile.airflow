FROM apache/airflow:2.7.3-python3.11

USER root

# Install Java (PySpark), Docker CLI (dbt tasks via docker exec), and gosu
RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        default-jdk-headless wget gosu docker.io && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* && \
    groupadd -g 999 docker 2>/dev/null || true && \
    usermod -aG docker airflow

# Set JAVA_HOME
ENV JAVA_HOME=/usr/lib/jvm/default-java
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Download PostgreSQL JDBC driver
RUN mkdir -p /opt/airflow/jars && \
    wget -q -O /opt/airflow/jars/postgresql-42.7.3.jar \
    https://jdbc.postgresql.org/download/postgresql-42.7.3.jar

# Pre-create log dirs with correct ownership
RUN mkdir -p /opt/airflow/logs/scheduler && \
    chown -R airflow:root /opt/airflow/logs && \
    chmod -R 775 /opt/airflow/logs

USER airflow

ENV PATH="/home/airflow/.local/bin:${PATH}"

RUN pip install --no-cache-dir \
    pyspark==3.5.0 \
    psycopg2-binary \
    boto3 \
    pandas